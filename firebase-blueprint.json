{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user profile storing authenticated Google account details for the signed-in devotee.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication UID matching the document ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name from Google Sign-In."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "Verified Gmail address (PII, owner-only access)."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Profile avatar URL from Google account."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["uid", "displayName", "email", "photoURL", "createdAt", "updatedAt"]
    },
    "Reaction": {
      "title": "Reaction",
      "description": "Publicly countable Good or Love reaction on a monastery Dhamma post.",
      "type": "object",
      "properties": {
        "postId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Target post identifier."
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the reacting user."
        },
        "reactionType": {
          "type": "string",
          "enum": ["good", "love"],
          "description": "Reaction kind: good or love."
        },
        "isPublic": {
          "type": "boolean",
          "description": "Must be true so reactions are publicly countable."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["postId", "userId", "reactionType", "isPublic", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Public Dhamma community comment on a monastery post.",
      "type": "object",
      "properties": {
        "postId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Target post identifier."
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the comment author."
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Public display name of the author."
        },
        "authorPhoto": {
          "type": "string",
          "maxLength": 500,
          "description": "Public avatar URL of the author."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Myanmar or English comment text."
        },
        "isPublic": {
          "type": "boolean",
          "description": "Must be true for public monastery feed visibility."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["postId", "authorId", "authorName", "authorPhoto", "text", "isPublic", "createdAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Admin-managed monastery announcement or Dhamma article.",
      "type": "object",
      "properties": {
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "dateMyanmar": { "type": "string", "minLength": 1, "maxLength": 80 },
        "author": { "type": "string", "minLength": 1, "maxLength": 100 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "body": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "image": { "type": "string", "maxLength": 1000 },
        "imageAlt": { "type": "string", "maxLength": 200 },
        "audioUrl": { "type": "string", "maxLength": 1000 },
        "videoUrl": { "type": "string", "maxLength": 1000 },
        "initialGood": { "type": "number" },
        "initialLove": { "type": "number" },
        "isPublic": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "category", "dateMyanmar", "author", "title", "summary", "body",
        "image", "imageAlt", "initialGood", "initialLove",
        "isPublic", "isArchived", "createdBy", "createdAt", "updatedAt"
      ]
    },
    "AudioTalk": {
      "title": "AudioTalk",
      "description": "Admin-managed MP3 Dhamma audio talk.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "speaker": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": {
          "type": "string",
          "enum": ["ဒေါက်တာဘဒ္ဒန္တဉာဏိကတရားတော်များ", "ပရိတ်တော်", "သုတ္တန်"]
        },
        "durationSec": { "type": "number" },
        "dateLabel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "coverImage": { "type": "string", "maxLength": 1000 },
        "audioUrl": { "type": "string", "maxLength": 1000 },
        "isPublic": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title", "speaker", "category", "durationSec", "dateLabel", "description",
        "coverImage", "audioUrl", "isPublic", "isArchived", "createdBy", "createdAt", "updatedAt"
      ]
    },
    "VideoTeaching": {
      "title": "VideoTeaching",
      "description": "Admin-managed MP4 Dhamma video teaching.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "speaker": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "minLength": 1, "maxLength": 100 },
        "durationSec": { "type": "number" },
        "dateLabel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "thumbnail": { "type": "string", "maxLength": 1000 },
        "videoUrl": { "type": "string", "maxLength": 1000 },
        "isPublic": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title", "speaker", "category", "durationSec", "dateLabel", "description",
        "thumbnail", "videoUrl", "isPublic", "isArchived", "createdBy", "createdAt", "updatedAt"
      ]
    },
    "DhammaBook": {
      "title": "DhammaBook",
      "description": "Admin-managed Dhamma E-Book for the digital library.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "author": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "minLength": 1, "maxLength": 100 },
        "pagesLabel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "coverImage": { "type": "string", "maxLength": 1000 },
        "synopsis": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "content": { "type": "string", "minLength": 1, "maxLength": 50000 },
        "pdfUrl": { "type": "string", "maxLength": 1000 },
        "isPublic": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title", "author", "category", "pagesLabel", "coverImage", "synopsis",
        "content", "pdfUrl", "isPublic", "isArchived", "createdBy", "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/userProfiles/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-isolated private user profiles containing verified Google email PII."
    },
    "/reactions/{reactionId}": {
      "schema": { "$ref": "#/entities/Reaction" },
      "description": "Deterministic per-user reaction records (${postId}_${reactionType}_${userId}) for Good and Love counters."
    },
    "/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Community Dhamma comments attached to Home Feed posts."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Admin-managed Home Feed posts."
    },
    "/audioTalks/{talkId}": {
      "schema": { "$ref": "#/entities/AudioTalk" },
      "description": "Admin-managed MP3 Dhamma audio talks."
    },
    "/videos/{videoId}": {
      "schema": { "$ref": "#/entities/VideoTeaching" },
      "description": "Admin-managed MP4 Dhamma video teachings."
    },
    "/books/{bookId}": {
      "schema": { "$ref": "#/entities/DhammaBook" },
      "description": "Admin-managed Dhamma E-Books."
    }
  }
}
